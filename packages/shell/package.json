{
  "name": "@slaclab/canopy-shell",
  "version": "0.3.0",
  "private": false,
  "description": "The standard Canopy app chrome — SLAC-branded Carbon AppHeader, g10/g100 color-mode store, AppShell/SideNavRail layout, toasts, confirm dialogs and an error boundary",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaclab/canopy-sdk-js.git",
    "directory": "packages/shell"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color-mode": {
      "types": "./dist/colorMode.d.ts",
      "import": "./dist/colorMode.js"
    },
    "./styles.css": "./styles.css",
    "./host-contract.css": "./host-contract.css",
    "./tokens.json": "./tokens.json",
    "./wiring.json": "./wiring.json",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "styles.css",
    "host-contract.css",
    "tokens.json",
    "wiring.json",
    "fixtures"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "gen-tokens": "node scripts/gen-tokens.mjs",
    "test": "node scripts/gen-tokens.mjs --check && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@carbon/icons-react": "^11.50.0",
    "@carbon/react": "^1.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@carbon/icons-react": "^11.81.0",
    "@carbon/react": "^1.111.0",
    "@carbon/styles": "1.110.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
