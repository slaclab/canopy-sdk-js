{
  "name": "@slaclab/canopy-screen-ir",
  "version": "0.3.0",
  "private": false,
  "description": "The Canopy Screen IR contract for TypeScript — the *.screen.json JSON Schema and widget definitions (copied from slaclab/canopy-spec), TypeScript model types, and a validate() helper. Used by the screen builder, the runtime viewer, and the content repo's CI.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaclab/canopy-sdk-js.git",
    "directory": "packages/screen-ir"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schema.json": "./spec/screen-ir/screen-ir.schema.json",
    "./color-scheme.schema.json": "./spec/screen-ir/color-scheme.schema.json"
  },
  "files": [
    "dist",
    "spec/screen-ir",
    "data"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "spec:sync": "node scripts/sync-spec.mjs sync",
    "spec:check": "node scripts/sync-spec.mjs check"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
